DATABASE_URL="file:./prisma/dev.db"
SESSION_SECRET="generate-a-random-string-of-32+-chars"
# Leave Razorpay keys empty to use the local mock payment provider (dev only).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# Set to "mock" for a simulated local checkout. Never in production; use RAZORPAY_* instead.
PAYMENTS_MODE=""

# Easebuzz (hosted redirect checkout). Set key+salt to use it instead of the mock gateway.
# If Razorpay keys are also set, add PAYMENTS_PROVIDER="easebuzz" to choose Easebuzz.
EASEBUZZ_KEY=""
EASEBUZZ_SALT=""
EASEBUZZ_ENV="test" # "test" = testpay.easebuzz.in sandbox, "prod" = live
PAYMENTS_PROVIDER=""
